# Interactive-only terminal-kit shell settings; intentionally no network or output.
[[ $- == *i* ]] || return 0
[[ ${_TERMINAL_KIT_RC_LOADED:-} == 1 ]] && return 0
_TERMINAL_KIT_RC_LOADED=1

HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE=32768
shopt -s histappend checkwinsize

_terminal_kit_bash="$HOME/.config/terminal-kit/bash"
for _terminal_kit_file in aliases completions; do
  [[ -r "$_terminal_kit_bash/$_terminal_kit_file" ]] && source "$_terminal_kit_bash/$_terminal_kit_file"
done
[[ -r "$_terminal_kit_bash/inputrc" ]] && bind -f "$_terminal_kit_bash/inputrc"
unset _terminal_kit_bash _terminal_kit_file

# Keep an existing mise integration; otherwise enable normal project runtimes.
if command -v mise >/dev/null 2>&1 && ! declare -F _mise_hook >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v fzf >/dev/null 2>&1; then
  _terminal_kit_fzf_init="$(fzf --bash 2>/dev/null)" || _terminal_kit_fzf_init=
  if [[ -n $_terminal_kit_fzf_init ]]; then
    eval "$_terminal_kit_fzf_init"
  else
    if [[ -n ${BASH_COMPLETION_COMPAT_DIR:-} && -r "$BASH_COMPLETION_COMPAT_DIR/fzf-completion.bash" ]]; then
      source "$BASH_COMPLETION_COMPAT_DIR/fzf-completion.bash"
    elif [[ -r /usr/share/fzf/completion.bash ]]; then
      source /usr/share/fzf/completion.bash
    fi
    if [[ -n ${BASH_COMPLETION_COMPAT_DIR:-} && -r "$BASH_COMPLETION_COMPAT_DIR/fzf-key-bindings.bash" ]]; then
      source "$BASH_COMPLETION_COMPAT_DIR/fzf-key-bindings.bash"
    elif [[ -r /usr/share/fzf/key-bindings.bash ]]; then
      source /usr/share/fzf/key-bindings.bash
    fi
  fi
  unset _terminal_kit_fzf_init
fi
if command -v fzf >/dev/null 2>&1 && command -v bat >/dev/null 2>&1; then
  alias ff="fzf --preview 'bat --style=numbers --color=always -- {}'"
  eff() {
    local file
    file=$(ff) && [[ -n $file ]] && "${EDITOR:-nvim}" "$file"
  }
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='eza -lah --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='eza --tree --level=2 --long --icons --git -a'
fi
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias g='git'

if [[ -z ${STARSHIP_CONFIG:-} ]]; then
  if [[ -r "$HOME/.config/terminal-kit/local/starship.toml" ]]; then
    export STARSHIP_CONFIG="$HOME/.config/terminal-kit/local/starship.toml"
  else
    export STARSHIP_CONFIG="$HOME/.config/terminal-kit/starship.toml"
  fi
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
  zd() {
    if [[ $# -eq 0 ]]; then builtin cd ~;
    elif [[ $# -gt 1 || $1 == -* || -d $1 ]]; then builtin cd "$@";
    else z "$@" && pwd; fi
  }
  alias cd='zd'
fi
if command -v starship >/dev/null 2>&1 && [[ ${TERM:-} != dumb ]]; then
  eval "$(starship init bash)"
fi

# Layout entrypoints are explicit CLI calls; startup never creates a tmux session.
if command -v terminal-kit >/dev/null 2>&1; then
  tdl() { terminal-kit layout tdl "$@"; }
  tds() { terminal-kit layout tds "$@"; }
  tdlm() { terminal-kit layout tdlm "$@"; }
  tsl() { terminal-kit layout tsl "$@"; }
fi

if [[ ${TERMINAL_KIT_AUTO_TMUX:-0} == 1 && -z ${TMUX:-} && -t 0 && -t 1 ]] \
  && command -v tmux >/dev/null 2>&1 && command -v terminal-kit >/dev/null 2>&1; then
  exec terminal-kit layout sessions new "${TERMINAL_KIT_TMUX_SESSION:-Work}"
fi

_terminal_kit_local_bash="$HOME/.config/terminal-kit/local/bash.sh"
[[ -r $_terminal_kit_local_bash ]] && source "$_terminal_kit_local_bash"
unset _terminal_kit_local_bash
