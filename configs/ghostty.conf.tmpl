# Generated by terminal-kit. User overrides belong in ~/.config/terminal-kit/local/ghostty.conf.
command = "@BASH_COMMAND@"
font-family = "JetBrainsMono Nerd Font"
font-size = 9
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env
shell-integration = bash
scrollback-limit = 10000000
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
macos-option-as-alt = true
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
mouse-scroll-multiplier = 0.95
background = @BACKGROUND@
foreground = @FOREGROUND@
cursor-color = @CURSOR@
selection-background = @SELECTION@
selection-foreground = @FOREGROUND@
palette = 0=@BACKGROUND@
palette = 1=@RED@
palette = 2=@GREEN@
palette = 3=@YELLOW@
palette = 4=@BLUE@
palette = 5=@MAGENTA@
palette = 6=@CYAN@
palette = 7=@FOREGROUND@
palette = 8=@DARK_FOREGROUND@
palette = 9=@BRIGHT_RED@
palette = 10=@BRIGHT_GREEN@
palette = 11=@BRIGHT_YELLOW@
palette = 12=@BRIGHT_BLUE@
palette = 13=@BRIGHT_MAGENTA@
palette = 14=@BRIGHT_CYAN@
palette = 15=@BRIGHT_FOREGROUND@
config-file = ?~/.config/terminal-kit/local/ghostty.conf
